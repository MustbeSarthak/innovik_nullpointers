# Optional Acno AI integration. Leave unset to use deterministic Module 5 safety rules.
ACNO_AI_API_KEY=
ACNO_AI_BASE_URL=
ACNO_AI_MODEL=
ACNO_AI_TIMEOUT_SECONDS=5

# Module 6 demo monitoring configuration
VITAL_SIMULATOR_INTERVAL_SECONDS=5
ALERT_ACK_TIMEOUT_SECONDS=300
CARETAKER_PHONE_NUMBER=
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE_NUMBER=
TWILIO_TIMEOUT_SECONDS=10
HOSPITAL_PROVIDER=mock

# Meta WhatsApp Cloud API caretaker notifications. The message is sent from the
# Meta-registered business number identified by WHATSAPP_PHONE_NUMBER_ID. The
# patient's phone number is included in the alert; WhatsApp does not allow an
# arbitrary patient's personal number to be used as the sender.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v22.0
WHATSAPP_TIMEOUT_SECONDS=10
